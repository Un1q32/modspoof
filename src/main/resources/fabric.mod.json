{
	"schemaVersion": 1,
	"id": "atm10spoof",
	"version": "${version}",
	"name": "ATM10 Spoof",
	"description": "Pretends to be a NeoForge client with the server's mods so you can join and walk around. Modded content is dropped or shown as stone.",
	"authors": ["Ava"],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.atm10spoof.Atm10SpoofClient"]
	},
	"mixins": [
		"atm10spoof.mixins.json",
		"atm10spoof.via.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"recommends": {
		"viafabricplus": "*"
	}
}
